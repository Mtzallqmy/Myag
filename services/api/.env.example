SUPABASE_URL=https://ywtfvgkhrmouqxsocgdq.supabase.co
SUPABASE_PUBLISHABLE_KEY=selected_project_publishable_key
SUPABASE_SERVICE_ROLE_KEY=selected_project_server_key
# Empty selected project: generate once and keep securely. For old ciphertext, use its original key.
PROVIDER_ENCRYPTION_KEY_V1=replace_with_a_secure_random_key_at_least_32_characters
PUBLIC_API_ORIGIN=https://your-verified-botkeep-domain.example
SERVER_PORT=3000
NODE_ENV=production
# Optional, comma-separated exact web origins. Android does not need CORS.
CORS_ORIGINS=
# Optional isolated runtime; without it validation is UNAVAILABLE.
AGENT_RUNTIME_BASE_URL=
AGENT_RUNTIME_SHARED_SECRET=

# Enable only after reviewing/applying the queue migration to the EXISTING DB.
WAKEEL_WORKER_ENABLED=false
