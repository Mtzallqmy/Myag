SUPABASE_URL=https://iwzzseqztdxrrqlbazip.supabase.co
SUPABASE_PUBLISHABLE_KEY=existing_project_publishable_key
SUPABASE_SERVICE_ROLE_KEY=existing_project_server_key
# Keep the exact existing key; changing it makes stored credentials unreadable.
PROVIDER_ENCRYPTION_KEY_V1=existing_encryption_key_at_least_32_characters
PUBLIC_API_ORIGIN=https://your-verified-botkeep-domain.example
SERVER_PORT=3000
NODE_ENV=production
# Optional, comma-separated exact web origins. Android does not need CORS.
CORS_ORIGINS=
# Optional isolated runtime; without it validation is UNAVAILABLE.
AGENT_RUNTIME_BASE_URL=
AGENT_RUNTIME_SHARED_SECRET=

# Enable only after reviewing/applying the queue migration to the EXISTING DB.
WAKEEL_WORKER_ENABLED=false
